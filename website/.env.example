# Chat endpoint. In production use the same-origin CloudFront path (/chat) so the
# browser skips the CORS preflight; for local dev point it at the raw
# ChatFunctionUrl stack output, which allows http://localhost:3000 via CORS.
#   prod: /chat
#   dev:  https://<id>.lambda-url.us-east-1.on.aws/
VITE_CHAT_URL=
